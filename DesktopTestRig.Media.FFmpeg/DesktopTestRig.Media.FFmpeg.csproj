<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>DesktopTestRig.Media.FFmpeg</PackageId>
    <Description>Optional FFmpeg binary used by DesktopTestRig video recording.</Description>
    <PackageTags>DesktopTestRig;FFmpeg;Media;Recording</PackageTags>
    <PackageProjectUrl>https://DesktopTestRig.local</PackageProjectUrl>
    <RepositoryUrl>https://DesktopTestRig.local/repository</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="tools\ffmpeg.exe" Pack="true" PackagePath="contentFiles\any\any\DesktopTestRigResources\ffmpeg.exe" PackageCopyToOutput="true" />
    <None Include="ffmpeg.sha256" Pack="true" PackagePath="provenance\ffmpeg.sha256" />
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="NOTICE.md" Pack="true" PackagePath="NOTICE.md" />
    <None Include="DesktopTestRig.Media.FFmpeg.targets" Pack="true" PackagePath="build\DesktopTestRig.Media.FFmpeg.targets" />
  </ItemGroup>

  <Target Name="ValidateFfmpegBinary" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\tools\ffmpeg.exe')" Text="The FFmpeg package source executable is missing." />
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\ffmpeg.sha256">
      <Output TaskParameter="Lines" ItemName="_ExpectedFfmpegHash" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_ExpectedFfmpegHashValue>@(_ExpectedFfmpegHash)</_ExpectedFfmpegHashValue>
      <_ExpectedFfmpegHashValue>$(_ExpectedFfmpegHashValue.ToUpperInvariant())</_ExpectedFfmpegHashValue>
    </PropertyGroup>
    <GetFileHash Files="$(MSBuildProjectDirectory)\tools\ffmpeg.exe" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_ActualFfmpegHash" />
    </GetFileHash>
    <Error
      Condition="'%(_ActualFfmpegHash.FileHash)' != '$(_ExpectedFfmpegHashValue)'"
      Text="The FFmpeg executable does not match ffmpeg.sha256." />
  </Target>
</Project>
