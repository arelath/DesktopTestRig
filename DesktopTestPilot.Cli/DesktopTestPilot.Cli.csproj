<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DesktopTestPilot.Cli</RootNamespace>
    <AssemblyName>DesktopTestPilot.Cli</AssemblyName>
    <IsPackable>false</IsPackable>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishDir>$(ArtifactsRoot)publish\$(MSBuildProjectName)\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <ProjectReference Include="..\DesktopTestPilot.Automation\DesktopTestPilot.Automation.csproj" />
    <ProjectReference Include="..\DesktopTestPilot\DesktopTestPilot.csproj" />
  </ItemGroup>

  <Import Project="..\Shared\DesktopTestPilotPayloadLayout.targets" />
</Project>
