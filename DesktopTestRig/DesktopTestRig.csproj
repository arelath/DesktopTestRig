<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>$(DesktopTestRigTargetFrameworks)</TargetFrameworks>
    <RootNamespace>DesktopTestRig</RootNamespace>
    <AssemblyName>DesktopTestRig</AssemblyName>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Windows desktop UI automation library for WPF and Windows Forms applications.</Description>
    <PackageTags>WPF;Automation;Testing;UI</PackageTags>
    <PackageProjectUrl>https://github.com/arelath/DesktopTestRig</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arelath/DesktopTestRig</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <PackageId>DesktopTestRig</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <!-- Payload and native injector DLLs are executable content, not compile references. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\NativeMethods.cs" Link="Shared\NativeMethods.cs" />
    <Compile Include="..\Shared\NativeMethods.Kernel32.cs" Link="Shared\NativeMethods.Kernel32.cs" />
    <Compile Include="..\Shared\NativeMethods.User32.cs" Link="Shared\NativeMethods.User32.cs" />
    <PackageReference Include="Microsoft.CSharp" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serialize.Linq" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.ValueTuple" />
    <None Include="$(ArtifactsStagingRoot)payloads\**\*.*" Pack="true" PackagePath="contentFiles\any\any\payloads\%(RecursiveDir)%(Filename)%(Extension)" PackageCopyToOutput="true" Visible="false" />
    <None Include="$(ArtifactsStagingRoot)DesktopTestRigResources\**\*.*" Pack="true" PackagePath="contentFiles\any\any\DesktopTestRigResources\%(RecursiveDir)%(Filename)%(Extension)" PackageCopyToOutput="true" Visible="false" />
    <None Include="DesktopTestRig.targets" Pack="true" PackagePath="build\DesktopTestRig.targets" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="LICENSE.txt" />
  </ItemGroup>

  <Import Project="..\Shared\Protocol\DesktopTestRig.Protocol.projitems" />
  <Import Project="..\Shared\QueryModel\DesktopTestRig.QueryModel.projitems" />

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net461" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="ValidateDesktopTestRigPackageInputs" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_EvaluatedPayloadFrameworks>@(PayloadFramework, ';')</_EvaluatedPayloadFrameworks>
    </PropertyGroup>
    <Error Condition="'$(_EvaluatedPayloadFrameworks)' != '$(DesktopTestRigTargetFrameworks)'" Text="DesktopTestRigTargetFrameworks must match the PayloadFramework item identities and order." />
    <Error Condition="'%(PayloadFramework.Family)' == ''" Text="PayloadFramework '%(PayloadFramework.Identity)' must declare Family metadata." />
    <Error Condition="!Exists('$(ArtifactsStagingRoot)payloads')" Text="Payload staging is missing. Build the payloads before packing." />
    <Error Condition="!Exists('$(ArtifactsStagingRoot)DesktopTestRigResources')" Text="Injector staging is missing. Build the native injectors before packing." />
  </Target>
</Project>
